{
  "name": "tsql-debugger",
  "displayName": "T-SQL Debugger",
  "description": "Breakpoint debugging for T-SQL scripts and stored procedures in SQL Server.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers"],
  "activationEvents": ["onDebugResolve:tsql"],
  "main": "./out/extension.js",
  "extensionDependencies": ["ms-dotnettools.vscode-dotnet-runtime"],
  "contributes": {
    "configuration": {
      "title": "T-SQL Debugger",
      "properties": {
        "tsql-debugger.connectionString": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "SQL Server connection string som används när launch-konfigurationen saknar `connectionString`. Lämna tom för att bli tillfrågad vid start."
        }
      }
    },
    "breakpoints": [{ "language": "sql" }],
    "debuggers": [
      {
        "type": "tsql",
        "label": "T-SQL Debugger",
        "languages": ["sql"],
        "configurationAttributes": {
          "launch": {
            "required": ["program", "connectionString"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Sökväg till .sql-filen som ska debuggas.",
                "default": "${file}"
              },
              "connectionString": {
                "type": "string",
                "description": "SQL Server connection string."
              },
              "mode": {
                "type": "string",
                "enum": ["invoke", "attach"],
                "default": "invoke",
                "description": "invoke = kör själv, attach = vänta på markerad trafik (kräver licens mot remote)."
              },
              "params": {
                "type": "object",
                "description": "Parametervärden vid invoke av stored procedure.",
                "default": {}
              },
              "sidecarUrl": {
                "type": "string",
                "default": "http://localhost:5199",
                "description": "URL till sidecar-tjänsten."
              },
              "autoStartSidecar": {
                "type": "boolean",
                "default": true,
                "description": "Starta sidecaren automatiskt (via npx) om ingen redan svarar på sidecarUrl."
              },
              "sidecarCommand": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Kommando som startar sidecaren; --port läggs på automatiskt. Default: [\"npx\", \"-y\", \"tsql-debugger-sidecar\"]. Under utveckling: [\"dotnet\", \"run\", \"--project\", \"${workspaceFolder}/sidecar\", \"--\"]."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tsql",
            "request": "launch",
            "name": "Debug T-SQL (lokal)",
            "program": "${file}",
            "connectionString": "Server=(localdb)\\MSSQLLocalDB;Database=MyDb;Integrated Security=true;TrustServerCertificate=true",
            "mode": "invoke"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "bundle-sidecar": "dotnet publish ../sidecar -c Release -o sidecar-dist",
    "package": "npm run compile && npm run bundle-sidecar && vsce package"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
