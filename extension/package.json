{
  "name": "sqldbgr",
  "displayName": "sqldbgr",
  "description": "Breakpoint debugging for T-SQL scripts and stored procedures in SQL Server.",
  "version": "0.1.0",
  "publisher": "tobias-trunehag",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/t0bbz0n/sqldbgr-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:tsql",
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "contributes": {
    "configuration": {
      "title": "sqldbgr",
      "properties": {
        "sqldbgr.connectionString": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.connectionString%"
        },
        "sqldbgr.moduleFiles": {
          "type": "string",
          "enum": [
            "ask",
            "debug",
            "run"
          ],
          "default": "ask",
          "description": "%config.moduleFiles%"
        },
        "sqldbgr.attachExtension": {
          "type": "string",
          "default": "tobias-trunehag.sqldbgr-attach",
          "description": "%config.attachExtension%"
        }
      }
    },
    "breakpoints": [
      {
        "language": "sql"
      }
    ],
    "debuggers": [
      {
        "type": "tsql",
        "label": "sqldbgr",
        "languages": [
          "sql"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%launch.program%",
                "default": "${file}"
              },
              "connectionString": {
                "type": "string",
                "description": "%launch.connectionString%"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "invoke",
                  "module",
                  "attach"
                ],
                "default": "invoke",
                "description": "%launch.mode%"
              },
              "params": {
                "type": "object",
                "description": "%launch.params%",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "%launch.stopOnEntry%"
              },
              "transaction": {
                "type": "string",
                "enum": [
                  "none",
                  "rollback",
                  "commit"
                ],
                "default": "none",
                "description": "%launch.transaction%"
              },
              "debugDatabase": {
                "type": "string",
                "description": "%launch.debugDatabase%"
              },
              "sidecarUrl": {
                "type": "string",
                "description": "%launch.sidecarUrl%"
              },
              "sidecarToken": {
                "type": "string",
                "description": "%launch.sidecarToken%"
              },
              "autoStartSidecar": {
                "type": "boolean",
                "default": true,
                "description": "%launch.autoStartSidecar%"
              },
              "sidecarCommand": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%launch.sidecarCommand%"
              }
            }
          },
          "attach": {
            "required": [
              "connectionString"
            ],
            "properties": {
              "connectionString": {
                "type": "string",
                "description": "%launch.connectionString%"
              },
              "program": {
                "type": "string",
                "description": "%attach.program%"
              },
              "debugDatabase": {
                "type": "string",
                "description": "%launch.debugDatabase%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tsql",
            "request": "launch",
            "name": "Debug T-SQL (local)",
            "program": "${file}",
            "connectionString": "Server=(localdb)\\\\MSSQLLocalDB;Database=MyDb;Integrated Security=true;TrustServerCertificate=true",
            "mode": "invoke"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%snippet.local%",
            "description": "%snippet.local%",
            "body": {
              "type": "tsql",
              "request": "launch",
              "name": "Debug T-SQL (local)",
              "program": "^\"\\${file}\"",
              "connectionString": "Server=(localdb)\\\\MSSQLLocalDB;Database=MyDb;Integrated Security=true;TrustServerCertificate=true"
            }
          },
          {
            "label": "%snippet.dryrun%",
            "description": "%snippet.dryrun%",
            "body": {
              "type": "tsql",
              "request": "launch",
              "name": "Debug T-SQL (dry run)",
              "program": "^\"\\${file}\"",
              "connectionString": "Server=(localdb)\\\\MSSQLLocalDB;Database=MyDb;Integrated Security=true;TrustServerCertificate=true",
              "transaction": "rollback"
            }
          },
          {
            "label": "%snippet.attach%",
            "description": "%snippet.attach%",
            "body": {
              "type": "tsql",
              "request": "attach",
              "name": "Attach to a running procedure",
              "connectionString": "Server=myserver;Database=MyDb;Integrated Security=true;TrustServerCertificate=true"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "sqldbgr.debugCurrentFile",
        "title": "%command.debugCurrentFile%",
        "category": "sqldbgr",
        "icon": "$(debug-alt)"
      },
      {
        "command": "sqldbgr.debugModule",
        "title": "%command.debugModule%",
        "category": "sqldbgr"
      },
      {
        "command": "sqldbgr.openLastResults",
        "title": "%command.openLastResults%",
        "category": "sqldbgr"
      },
      {
        "command": "sqldbgr.forgetConnection",
        "title": "%command.forgetConnection%",
        "category": "sqldbgr"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqldbgr.debugCurrentFile",
          "when": "editorLangId == sql"
        },
        {
          "command": "sqldbgr.debugModule",
          "when": "editorLangId == sql"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "bundle-sidecar": "node scripts/bundle-sidecar.js",
    "package": "npm run compile && npm run bundle-sidecar && vsce package"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "l10n": "./l10n"
}
