<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sidecar\SqlDebugger.Sidecar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner reads the schema from AppContext.BaseDirectory/Db -->
    <Content Include="..\..\sidecar\Db\DebugSchema.sql" Link="Db\DebugSchema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only so the sidecar is BUILT along with the tests. No reference to its
         assembly: SidecarProcess starts it as a process of its own, and
         `dotnet run` from inside `dotnet test` deadlocks against the build
         already under way. -->
    <ProjectReference Include="../../sidecar/SqlDebugger.Sidecar.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

</Project>
